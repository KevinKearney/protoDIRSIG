MATERIAL_ENTRY {
    ID           = 1
    NAME         = Terrain (proxy)
    EDITOR_COLOR = 1, 1, 1
    DOUBLE_SIDED = FALSE

    RAD_SOLVER_NAME = Classic
    RAD_SOLVER {
        ENABLE_SAMPLED_DIFFUSE = FALSE
    }

    TEMP_SOLVER_NAME = Therm
    TEMP_SOLVER {
        SPECIFIC_HEAT        = 0.089
        MASS_DENSITY         = 7.833
        THERMAL_CONDUCTIVITY = 464.4
        SOLAR_ABSORPTION     = 0.88
        THERMAL_EMISSIVITY   = 0.7
        EXPOSED_AREA         = -0.5
        THICKNESS            = 1
    }

    SURFACE_PROPERTIES {

        EMISSIVITY_PROP_NAME = ClassicEmissivity
        EMISSIVITY_PROP {
            FILENAME          = emissivity/gray.ems
            SPECULAR_FRACTION = 0
        }
    }
}

