<classicscene>

  <metadata>
    <entry>
      <name>Author(s)</name>
      <value><![CDATA[Mike Gartley, Aaron Gerace and Scott Brown]]></value>
    </entry>
    <entry>
      <name>Description</name>
      <value><![CDATA[]]></value>
    </entry>
    <entry>
      <name>Name</name>
      <value><![CDATA[Lake Tahoe]]></value>
    </entry>
    <entry>
      <name>Organization</name>
      <value><![CDATA[Rochester Institute of Technology]]></value>
    </entry>
  </metadata>

  <sceneorigin>
    <location frame="geodetic">
      <latitude>39.0000000000</latitude>
      <longitude>-120.0000000000</longitude>
      <altitude>0.0000000000</altitude>
    </location>
  </sceneorigin>

  <properties features="vis,nir,swir,sources,exoatm" mingsd="0" maxgsd="0"/>

  <thumbnaillist>
  </thumbnaillist>

  <landmarks>
  </landmarks>

  <odbdirectory>$SCENE_DIR/geometry</odbdirectory>
  <gdbdirectory>$SCENE_DIR/geometry</gdbdirectory>
  <geometrylist enabled="true">
    <geometrylistinclude name="Terrain" enabled="true">lists/terrain.glist</geometrylistinclude>
    <geometrylistinclude name="New ODB" enabled="true">lists/hypersonic.glist</geometrylistinclude>
  </geometrylist>

  <matfilename>$SCENE_DIR/materials/tahoe.mat</matfilename>
  <emsdirectory>$SCENE_DIR/materials/</emsdirectory>
  <extdirectory>$SCENE_DIR/materials</extdirectory>
  <absdirectory>$SCENE_DIR/materials</absdirectory>
  <srcdirectory>$SCENE_DIR/materials</srcdirectory>

  <mapdirectory>$SCENE_DIR/maps</mapdirectory>
  <maplist>
    <materialmap name="Tahoe Class Map (small)" enabled="false" mixing="false">
      <matidlist>
        <matid>1</matid>
      </matidlist>
      <projector origin="cartesian" flipx="false" flipy="false" extendx="mirror" extendy="mirror" >
        <uvprojector/>
      </projector>
      <dcmatlut>
        <entry>
          <dc>28</dc><matid>11</matid>
        </entry>
        <entry>
          <dc>56</dc><matid>12</matid>
        </entry>
        <entry>
          <dc>85</dc><matid>13</matid>
        </entry>
        <entry>
          <dc>113</dc><matid>14</matid>
        </entry>
        <entry>
          <dc>142</dc><matid>15</matid>
        </entry>
        <entry>
          <dc>170</dc><matid>16</matid>
        </entry>
        <entry>
          <dc>199</dc><matid>17</matid>
        </entry>
        <entry>
          <dc>227</dc><matid>18</matid>
        </entry>
        <entry>
          <dc>255</dc><matid>19</matid>
        </entry>
      </dcmatlut>
      <image>
        <filename>material_map_small.pgm</filename>
      </image>
    </materialmap>
    <texturemap name="Tahoe Texture Map (small)" enabled="false">
      <matidlist>
        <matid>11</matid>
        <matid>12</matid>
        <matid>13</matid>
        <matid>14</matid>
        <matid>15</matid>
        <matid>16</matid>
        <matid>17</matid>
        <matid>18</matid>
        <matid>19</matid>
      </matidlist>
      <projector origin="cartesian" flipx="false" flipy="false" extendx="mirror" extendy="mirror" >
        <uvprojector/>
      </projector>
      <bandlist>
        <band>
          <bandpass>
            <min>0.4</min>
            <max>0.7</max>
          </bandpass>
          <image>
            <filename>texture_map_small.pgm</filename>
          </image>
        </band>
      </bandlist>
    </texturemap>
  </maplist>
</classicscene>
