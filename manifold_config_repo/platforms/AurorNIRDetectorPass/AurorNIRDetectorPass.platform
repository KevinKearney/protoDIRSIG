<platform>
  <metadata>
    <entry>
      <name>Author(s)</name>
      <value><![CDATA[]]></value>
    </entry>
    <entry>
      <name>Description</name>
      <value><![CDATA[]]></value>
    </entry>
    <entry>
      <name>Name</name>
      <value><![CDATA[New System/Platform]]></value>
    </entry>
    <entry>
      <name>Organization</name>
      <value><![CDATA[]]></value>
    </entry>
  </metadata>
  <clocktable/>
  <attachment>
    <affinetransform/>
    <mount name="New Mount" type="static">
      <data angularunits="radians" rotationorder="xyz">
        <xrotation>0.00000000e+00</xrotation>
        <yrotation>0.00000000e+00</yrotation>
        <zrotation>0.00000000e+00</zrotation>
      </data>
      <attachment>
        <affinetransform/>
        <instrument name="Auror NIR Detector" type="generic">
          <properties>
            <aperturediameter>0.085</aperturediameter>
            <aperturethroughput>0.875</aperturethroughput>
            <focallength>306</focallength>
          </properties>
          <focalplane enabled="true" name="CIS120">
            <capturemethod name="Simple" type="simple">
              <samplestrategy type="central">
                <hypersamplingmultiplier>100</hypersamplingmultiplier>
              </samplestrategy>
              <imagefile areaunits="m2" fluxunits="electronspersecond">
                <basename>AurorNIROutput</basename>
                <extension>img</extension>
                <schedule>capture</schedule>
                <datatype>5</datatype>
              </imagefile>
              <spectralresponse>
                <bandpass spectralunits="microns">
                  <minimum>0.41</minimum>
                  <maximum>2</maximum>
                  <delta>0.001</delta>
                </bandpass>
                <channellist>
                  <channel bias="0" gain="1" name="NIR Detector" normalize="false" shape="gaussian">
                    <center>0.8500</center>
                    <width>0.06369914</width>
                    <polarizer type="none"/>
                    <dataoutput type="total"/>
                  </channel>
                </channellist>
              </spectralresponse>
              <spatialresponse spatialsampling="subsamples" spectralunits="microns" xsubelements="1" ysubelements="1">
                <entry type="uniform">
                  <spectralpoint>0.4</spectralpoint>
                  <xwidth>1</xwidth>
                  <ywidth>1</ywidth>
                  <totalweight>1</totalweight>
                </entry>
              </spatialresponse>
              <temporalintegration tdi="false">
                <time>0.005</time>
                <samples>10</samples>
              </temporalintegration>
            </capturemethod>
            <detectorarray spatialunits="microns">
              <clock temporalunits="hertz" type="independent">
                <rate>1000</rate>
                <offset>0</offset>
              </clock>
              <xelementcount>500</xelementcount>
              <yelementcount>500</yelementcount>
              <xelementsize>10.000000</xelementsize>
              <yelementsize>10.000000</yelementsize>
              <xelementspacing>10.000000</xelementspacing>
              <yelementspacing>10.000000</yelementspacing>
              <xarrayoffset>0.000000</xarrayoffset>
              <yarrayoffset>0.000000</yarrayoffset>
              <xflipaxis>0</xflipaxis>
              <yflipaxis>0</yflipaxis>
            </detectorarray>
            <truthcollection>
              <enabled>true</enabled>
              <name></name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>Collection 1</name>
              <imagefile>
                <basename>truth1</basename>
                <extension>img</extension>
                <schedule>capture</schedule>
              </imagefile>
              <collectorlist>
                <collector>
                  <name>GeoLocation</name>
                </collector>
                <collector>
                  <name>Intersection</name>
                </collector>
              </collectorlist>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
