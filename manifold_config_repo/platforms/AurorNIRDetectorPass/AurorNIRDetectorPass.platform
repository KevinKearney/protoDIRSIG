              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
            <truthcollection>
              <enabled>true</enabled>
              <name>NewCollection</name>
              <imagefile>
                <basename>truth</basename>
                <extension>img</extension>
                <schedule>simulation</schedule>
              </imagefile>
              <collectorlist/>
            </truthcollection>
          </focalplane>
        </instrument>
      </attachment>
      <rotationdeviates/>
    </mount>
  </attachment>
</platform>
