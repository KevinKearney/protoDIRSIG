{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run-spec document",
  "description": "A `run-spec/1` document.",
  "type": "object",
  "required": [
    "spec_version",
    "descriptor",
    "engine"
  ],
  "properties": {
    "spec_version": {
      "description": "The run-spec version.",
      "const": "run-spec/1"
    },
    "descriptor": {
      "description": "What is observed and by which sensor.",
      "type": "object"
    },
    "engine": {
      "description": "How the engine is driven.",
      "type": "object"
    }
  }
}
