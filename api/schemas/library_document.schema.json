{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library document",
  "description": "One library resource as authored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "sha256",
    "document"
  ],
  "properties": {
    "name": {
      "description": "The name a recipe uses for the resource.",
      "type": "string"
    },
    "sha256": {
      "description": "The sha256 of the resource file's bytes, 64 lowercase hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document": {
      "description": "The parsed YAML document.",
      "type": "object"
    }
  }
}
