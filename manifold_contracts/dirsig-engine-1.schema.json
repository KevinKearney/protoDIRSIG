{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dirsig-engine/1",
  "title": "dirsig-engine/1 (proposed; Configuration_v02 A.8 as read by protoDIRSIG, with the new_atmosphere and orbit-motion extensions marked proposed)",
  "description": "The engine block of a run-spec/1 document whose descriptor.origin.engine is dirsig: what the generator and the executor consume to build and run one DIRSIG job. It is origin-specific and not indexed; the engine-independent description of the run is the descriptor. This schema is the SDK's reading of the MANIFOLD configuration document, not a MANIFOLD artefact. Rules this schema cannot express, enforced at admission by the loader: a stamped content_hash must equal the sha256 of the referenced file; every referenced library file must exist; the sha256:<hash> and <git-sha> placeholders are accepted here only where the layer files use them (a .scene ref and generator.revision) and are refused as content anywhere else; for kind orbit, every task window must lie inside the orbit window and the window must be a whole number of waypoint spacings. The $id follows sensor-spec-1.schema.json's convention (a relative id). References between the three contract schemas are sibling file names; a validator that rebases them on the relative $id must map the three files by name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generator",
    "scenes",
    "platform",
    "motion",
    "tasks",
    "atmosphere"
  ],
  "properties": {
    "generator": {
      "description": "The tool that turns this block into DIRSIG input files.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "spec_schema"
      ],
      "properties": {
        "tool": {
          "description": "The generator tool.",
          "enum": [
            "dirfm"
          ]
        },
        "revision": {
          "description": "The generator's revision: a git commit, or the placeholder <git-sha> that the layer files carry until the execution record states it.",
          "type": "string",
          "pattern": "^([0-9a-f]{7,40}|<git-sha>)$"
        },
        "spec_schema": {
          "description": "The engine schema this block is written against.",
          "const": "dirsig-engine/1"
        }
      }
    },
    "scenes": {
      "description": "The library scenes the job renders, each with an optional offset; at least one. (The SDK's loader handles one.)",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "One scene.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/sceneRef"
          },
          "offset": {
            "description": "Translation of the scene in the scene frame, metres [x, y, z].",
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "platform": {
      "description": "The library .platform template the generator renders the job's platform from, and how it renders it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "library_entry",
        "output_prefix"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/libraryRef"
        },
        "library_entry": {
          "description": "The name of the platform entry inside the template file.",
          "type": "string",
          "minLength": 1
        },
        "output_prefix": {
          "description": "A prefix for the job's output file names (recorded; not applied by the SDK's generator).",
          "type": "string"
        },
        "split_channels": {
          "description": "One spectral state per channel when true. The SDK refuses true with new_atmosphere at resolution.",
          "type": "boolean"
        },
        "integration_samples": {
          "description": "Temporal samples per integration period.",
          "type": "integer",
          "minimum": 1
        },
        "channel_response": {
          "description": "How the generator writes each channel: tabulated (the default; the sensor's composed response on the template's grid) or native (DIRSIG's own analytic channel, to reproduce a received platform).",
          "enum": [
            "tabulated",
            "native"
          ]
        }
      }
    },
    "motion": {
      "$ref": "#/$defs/motion"
    },
    "tasks": {
      "description": "When the platform captures.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows"
      ],
      "properties": {
        "windows": {
          "description": "Capture windows; one capture per window. A window with start equal to stop is one static sample.",
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "One window, seconds relative to descriptor.collection.epoch.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "stop"
            ],
            "properties": {
              "start": {
                "description": "Window start, seconds from the epoch.",
                "type": "number"
              },
              "stop": {
                "description": "Window stop, seconds from the epoch.",
                "type": "number"
              }
            }
          }
        }
      }
    },
    "atmosphere": {
      "$ref": "#/$defs/atmosphere"
    },
    "weather": {
      "$ref": "#/$defs/weather"
    },
    "ephemeris": {
      "description": "Sun and moon positions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin"
      ],
      "properties": {
        "plugin": {
          "description": "spice: the DIRSIG installation's SPICE kernels, no inputs.",
          "enum": [
            "spice"
          ]
        }
      }
    },
    "run": {
      "description": "Execution parameters recorded with the spec. Thread count is not here; convergence settings are not modelled by this version.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "description": "The random seed passed to scene2hdf and dirsig5; the same seed reproduces a render byte for byte.",
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "description": "Three numbers [x, y, z].",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "libraryRef": {
      "description": "A file in the engine-asset library (manifold_config_repo/), by its path under the library and the sha256 of its bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "content_hash"
      ],
      "properties": {
        "name": {
          "description": "The file's path under the library, for example platforms/AurorNIRDetector/AurorNIRDetector.platform.",
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "description": "sha256: followed by the 64 lowercase hex digits of the file's sha256.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sceneRef": {
      "description": "A library .scene file. Its geometry and materials sit beside it, so one file's hash does not identify the scene; the hash stays the placeholder sha256:<hash> until a scene hash is defined.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "content_hash"
      ],
      "properties": {
        "name": {
          "description": "The .scene file's path under the library, scenes/<scene>/<scene>.scene.",
          "type": "string",
          "pattern": "\\.scene$"
        },
        "content_hash": {
          "description": "sha256: and 64 hex digits, or the placeholder sha256:<hash>.",
          "type": "string",
          "pattern": "^sha256:([0-9a-f]{64}|<hash>)$"
        }
      }
    },
    "motion": {
      "description": "How the platform moves and points. kind static: one position and an Euler orientation. kind orbit (proposed): a library TLE propagated over a window into ECEF waypoints, pointed by a LookAt at a scene ENU point. kind waypoints: authored samples; its members are not defined by this version and the SDK refuses it at resolution.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "description": "The motion form.",
          "enum": [
            "static",
            "waypoints",
            "orbit"
          ]
        },
        "orientation": {
          "description": "How the platform points.",
          "type": "object",
          "properties": {
            "kind": {
              "description": "euler (static) or lookat (orbit).",
              "enum": [
                "euler",
                "lookat"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "static"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "description": "The static form.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "position",
              "orientation"
            ],
            "properties": {
              "kind": {
                "description": "static.",
                "const": "static"
              },
              "position": {
                "description": "The platform position at the epoch.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "frame",
                  "xyz"
                ],
                "properties": {
                  "frame": {
                    "description": "The frame of xyz; the SDK's generator writes scene-frame positions.",
                    "type": "string"
                  },
                  "xyz": {
                    "description": "Position, metres.",
                    "$ref": "#/$defs/vector3"
                  }
                }
              },
              "orientation": {
                "description": "An Euler orientation.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "euler"
                ],
                "properties": {
                  "kind": {
                    "description": "euler.",
                    "const": "euler"
                  },
                  "euler": {
                    "description": "Euler angles.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "order",
                      "units",
                      "frame",
                      "angles"
                    ],
                    "properties": {
                      "order": {
                        "description": "Rotation order, for example xyz.",
                        "type": "string",
                        "pattern": "^[xyz]{3}$"
                      },
                      "units": {
                        "description": "Angle units, for example radians.",
                        "type": "string"
                      },
                      "frame": {
                        "description": "The frame the angles rotate from; the SDK's generator writes sceneenu.",
                        "type": "string"
                      },
                      "angles": {
                        "description": "The three angles, in order.",
                        "$ref": "#/$defs/vector3"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "orbit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "description": "The orbit form (proposed).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "orbit",
              "orientation"
            ],
            "properties": {
              "kind": {
                "description": "orbit.",
                "const": "orbit"
              },
              "orbit": {
                "description": "The propagation law.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tle",
                  "propagator",
                  "earth_orientation",
                  "window",
                  "waypoint_spacing"
                ],
                "properties": {
                  "tle": {
                    "description": "The two-line element set, a library file under orbit/.",
                    "$ref": "#/$defs/libraryRef"
                  },
                  "propagator": {
                    "description": "The propagator; skyfield_sgp4 is SGP4 with UT1 - UTC from earth_orientation.",
                    "enum": [
                      "skyfield_sgp4"
                    ]
                  },
                  "earth_orientation": {
                    "description": "The Earth-orientation (UT1 - UTC) tables, a library file under orbit/.",
                    "$ref": "#/$defs/libraryRef"
                  },
                  "window": {
                    "description": "The propagated span, seconds relative to descriptor.collection.epoch.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start",
                      "duration"
                    ],
                    "properties": {
                      "start": {
                        "description": "Window start, seconds from the epoch.",
                        "type": "number"
                      },
                      "duration": {
                        "description": "Window length, seconds.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  },
                  "waypoint_spacing": {
                    "description": "Seconds between ECEF waypoints.",
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "orientation": {
                "description": "A LookAt orientation.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "lookat"
                ],
                "properties": {
                  "kind": {
                    "description": "lookat.",
                    "const": "lookat"
                  },
                  "lookat": {
                    "description": "The pointing law.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "frame",
                      "target",
                      "up"
                    ],
                    "properties": {
                      "frame": {
                        "description": "The frame of target.",
                        "enum": [
                          "sceneenu"
                        ]
                      },
                      "target": {
                        "description": "The point the boresight follows, metres, scene ENU.",
                        "$ref": "#/$defs/vector3"
                      },
                      "up": {
                        "description": "along_track: the horizontal velocity direction at the window centre, held fixed.",
                        "enum": [
                          "along_track"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "atmosphere": {
      "description": "The atmosphere model. four_curve and basic are the adopted plugins (A.8.7); their members are not modelled by this version. new_atmosphere (proposed) reads a prebuilt NewAtmosphere database from the library.",
      "type": "object",
      "required": [
        "plugin"
      ],
      "properties": {
        "plugin": {
          "description": "The atmosphere plugin.",
          "enum": [
            "four_curve",
            "basic",
            "new_atmosphere"
          ]
        }
      },
      "if": {
        "properties": {
          "plugin": {
            "const": "new_atmosphere"
          }
        },
        "required": [
          "plugin"
        ]
      },
      "then": {
        "description": "The new_atmosphere form (proposed).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin",
          "database"
        ],
        "properties": {
          "plugin": {
            "description": "new_atmosphere.",
            "const": "new_atmosphere"
          },
          "database": {
            "description": "The database.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/libraryRef"
              }
            }
          }
        }
      }
    },
    "weather": {
      "description": "The thermal weather file. source library: a file in the engine-asset library; source install: a file shipped with the DIRSIG installation, whose members this version does not model.",
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "description": "Where the weather file comes from.",
          "enum": [
            "library",
            "install"
          ]
        }
      },
      "if": {
        "properties": {
          "source": {
            "const": "library"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "description": "The library form.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "file"
        ],
        "properties": {
          "source": {
            "description": "library.",
            "const": "library"
          },
          "file": {
            "$ref": "#/$defs/libraryRef"
          }
        }
      }
    }
  }
}
